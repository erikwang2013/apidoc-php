{
    "name": "erikwang2013/apidoc-php",
    "description": "基于PHP 8 attributes生成API文档，兼容Laravel、ThinkPHP、Hyperf、Webman等框架；UIC-1统一接口、27个协议调试驱动、9种定义解析、声明式生成器、Markdown文档、多应用/多版本、Mock数据、授权访问、代码生成器等众多实用功能",
    "keywords": [
        "apidoc",
        "api文档",
        "接口文档",
        "自动生成api",
        "attribute生成",
        "php接口文档",
        "uic-1",
        "Markdown",
        "attributes",
        "websocket",
        "mqtt",
        "grpc",
        "thrift",
        "dubbo",
        "kafka",
        "amqp",
        "dnp3",
        "iec104",
        "bacnet",
        "opcua",
        "lwm2m",
        "openapi"
    ],
    "require": {
        "php": "^8.0"
    },
    "suggest": {
        "ext-dom": "Required for WSDL/XSD/EDMX definition parsing",
        "ext-curl": "Required for gRPC and HTTP relay in some drivers"
    },
    "archive": {
        "exclude": ["/site"]
    },
    "license": "MIT",
    "authors": [
        {
            "name": "erik",
            "email": "erik@erik.xyz",
            "homepage": "https://erik.xyz",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "erikwang2013\\apidoc\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "erikwang2013\\apidoc\\providers\\LaravelService"
            ]
        },
        "think": {
            "services": [
                "erikwang2013\\apidoc\\providers\\ThinkPHPService"
            ],
            "config": {
                "apidoc": "src/config.php"
            }
        },
        "hyperf": {
            "config": "erikwang2013\\apidoc\\ConfigProvider"
        }
    }
}