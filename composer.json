{
    "name": "erikwang2013/apidoc-php",
    "description": "基于PHP 8 attributes生成API文档，兼容Laravel、ThinkPHP、Hyperf、Webman等框架；在线调试、Markdown文档、多应用/多版本、Mock数据、授权访问、接口生成器、代码生成器等众多实用功能",
    "keywords": [
        "apidoc",
        "api文档",
        "接口文档",
        "自动生成api",
        "attribute生成",
        "php接口文档",
        "api文档",
        "Markdown",
        "attributes"
    ],
    "require": {
        "php": "^8.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "erik",
            "email": "erik@erik.xyz",
            "homepage": "https://erik.xyz",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "erikwang2013\\apidoc\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "erikwang2013\\apidoc\\providers\\LaravelService"
            ]
        },
        "think": {
            "services": [
                "erikwang2013\\apidoc\\providers\\ThinkPHPService"
            ],
            "config": {
                "apidoc": "src/config.php"
            }
        },
        "hyperf": {
            "config": "erikwang2013\\apidoc\\ConfigProvider"
        }
    },
    "minimum-stability": "dev"
}